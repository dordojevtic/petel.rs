---
import petelLogo from '../assets/Petel-logo.jpeg';
---

<section class="hero">
	<div class="hero-content">
		<div class="logo-container">
			<img src={petelLogo.src} alt="Petel Logo" class="logo" />
		</div>
		<h1 class="title">
			<span class="title-line">SAJT U IZRADI</span>
		</h1>
		<p class="subtitle">
			Radimo na tome da vam pružimo najbolje rešenje...
		</p>
		<div class="loading-dots">
			<span></span>
			<span></span>
			<span></span>
		</div>
	</div>
	<div class="floating-shapes">
		<div class="shape shape-1"></div>
		<div class="shape shape-2"></div>
		<div class="shape shape-3"></div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
		overflow: hidden;
		padding: 2rem;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		text-align: center;
		animation: fadeInUp 1s ease-out;
	}

	.logo-container {
		margin-bottom: 2rem;
		animation: logoFloat 3s ease-in-out infinite;
	}

	.logo {
		max-width: 200px;
		width: 100%;
		height: auto;
		filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.1));
	}

	.title {
		font-size: 3rem;
		font-weight: 700;
		margin-bottom: 1rem;
		color: #1a1a1a;
		position: relative;
	}

	.title-line {
		display: inline-block;
		position: relative;
		animation: slideIn 1s ease-out 0.3s both;
	}

	.title-line::after {
		content: '';
		position: absolute;
		bottom: -5px;
		left: 0;
		width: 0;
		height: 3px;
		background: linear-gradient(90deg, #0066cc, #00a3ff);
		animation: underlineExpand 1s ease-out 1.3s forwards;
	}

	.subtitle {
		font-size: 1.25rem;
		color: #4a5568;
		margin-bottom: 2rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
		opacity: 0;
		animation: fadeIn 1s ease-out 0.8s forwards;
	}

	.loading-dots {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 2rem;
	}

	.loading-dots span {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #0066cc;
		display: inline-block;
		animation: bounce 1.4s ease-in-out infinite both;
	}

	.loading-dots span:nth-child(1) {
		animation-delay: -0.32s;
	}

	.loading-dots span:nth-child(2) {
		animation-delay: -0.16s;
	}

	.floating-shapes {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
		pointer-events: none;
	}

	.shape {
		position: absolute;
		border-radius: 50%;
		background: rgba(0, 102, 204, 0.1);
		animation: float 20s infinite ease-in-out;
	}

	.shape-1 {
		width: 300px;
		height: 300px;
		top: 10%;
		left: 10%;
		animation-delay: 0s;
	}

	.shape-2 {
		width: 200px;
		height: 200px;
		top: 60%;
		right: 15%;
		animation-delay: -7s;
	}

	.shape-3 {
		width: 150px;
		height: 150px;
		bottom: 20%;
		left: 20%;
		animation-delay: -14s;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes logoFloat {
		0%, 100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-20px);
		}
	}

	@keyframes slideIn {
		from {
			opacity: 0;
			transform: translateX(-50px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes underlineExpand {
		to {
			width: 100%;
		}
	}

	@keyframes fadeIn {
		to {
			opacity: 1;
		}
	}

	@keyframes bounce {
		0%, 80%, 100% {
			transform: scale(0);
		}
		40% {
			transform: scale(1);
		}
	}

	@keyframes float {
		0%, 100% {
			transform: translate(0, 0) rotate(0deg);
		}
		33% {
			transform: translate(30px, -30px) rotate(120deg);
		}
		66% {
			transform: translate(-20px, 20px) rotate(240deg);
		}
	}

	@media (max-width: 768px) {
		.title {
			font-size: 2rem;
		}

		.subtitle {
			font-size: 1rem;
		}

		.logo {
			max-width: 150px;
		}

		.shape {
			opacity: 0.5;
		}
	}
</style>