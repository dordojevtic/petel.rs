---
import type { Locale } from '../types/i18n';
import { getLangFromUrl } from '../i18n/config';
import SEOHead from '../components/seo/SEOHead.astro';
import JsonLD from '../components/seo/JsonLD.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  image?: string;
  locale?: Locale;
  jsonLD?: Record<string, any>;
}

const {
  title,
  description,
  keywords = [],
  image,
  locale: propLocale,
  jsonLD
} = Astro.props;

// Get locale from URL or use prop
const locale = propLocale || getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

// Generate canonical URL
const canonicalUrl = `https://petel.rs${currentPath}`;

// Generate alternate URLs for hreflang
const serbianPath = currentPath.replace(/^\/en/, '') || '/';
const englishPath = currentPath.startsWith('/en') ? currentPath : `/en${currentPath}`;

const alternateUrls = [
  { locale: 'sr' as Locale, url: `https://petel.rs${serbianPath}` },
  { locale: 'en' as Locale, url: `https://petel.rs${englishPath}` }
];

// Set HTML lang attribute
const langCode = locale === 'sr' ? 'sr' : 'en';
---

<!doctype html>
<html lang={langCode}>
  <head>
    <SEOHead 
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      locale={locale}
      alternateUrls={alternateUrls}
      canonicalUrl={canonicalUrl}
      jsonLD={jsonLD}
    />
    
    <!-- Organization JSON-LD on every page -->
    <JsonLD type="organization" locale={locale} />
  </head>
  <body>
    <Header locale={locale} currentPath={currentPath} />
    
    <main class="main-content">
      <slot />
    </main>
    
    <Footer locale={locale} />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #1a1a1a;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
  }

  .main-content {
    flex: 1;
    width: 100%;
  }

  /* Typography */
  h1, h2, h3, h4, h5, h6 {
    margin: 0;
    font-weight: 600;
    line-height: 1.2;
    color: #0a0a0a;
  }

  h1 {
    font-size: 2.5rem;
  }

  h2 {
    font-size: 2rem;
  }

  h3 {
    font-size: 1.5rem;
  }

  h4 {
    font-size: 1.25rem;
  }

  p {
    margin: 0 0 1rem 0;
  }

  a {
    color: #0066cc;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: #0052a3;
  }

  /* Utility classes */
  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 3rem 0;
  }

  .section-title {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .section-description {
    text-align: center;
    color: #6b7280;
    max-width: 600px;
    margin: 0 auto 2rem;
  }

  /* Button styles */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: all 0.2s ease;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background-color: #08213a;
    color: #ffffff;
  }

  .btn-primary:hover {
    background-color: #0052a3;
    color: #ffffff;
  }

  .btn-secondary {
    background-color: #f3f4f6;
    color: #374151;
  }

  .btn-secondary:hover {
    background-color: #e5e7eb;
    color: #1f2937;
  }

  /* Responsive typography */
  @media (min-width: 768px) {
    html {
      font-size: 18px;
    }

    h1 {
      font-size: 3rem;
    }

    h2 {
      font-size: 2.5rem;
    }

    h3 {
      font-size: 1.75rem;
    }

    .container {
      padding: 0 2rem;
    }

    .section {
      padding: 4rem 0;
    }
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }

    h2 {
      font-size: 1.75rem;
    }

    h3 {
      font-size: 1.25rem;
    }

    .section-title {
      font-size: 1.75rem;
    }
  }
</style>
