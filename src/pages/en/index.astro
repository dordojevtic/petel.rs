---
import type { Product } from '../../types/product';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/products/ProductGrid.astro';
import rawProductsData from '../../data/products.json';

const locale = 'en';
const products = rawProductsData as unknown as Product[];
const featuredProducts = products.filter(p => p.featured);
---

<BaseLayout
  title="Petel - Low-Voltage Equipment and Electrical Materials"
  description="Petel is a leading supplier of high-quality low-voltage equipment. We offer a wide range of LED lighting, switches, cables, and automation for all your electrical needs."
  keywords={['low-voltage equipment', 'electrical materials', 'led lighting', 'switches', 'cables', 'distribution boards', 'automation', 'petel']}
  locale={locale}
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title">Welcome to Petel</h1>
        <p class="hero-description">
          Your trusted partner for high-quality low-voltage equipment and electrical materials.
          We offer a complete range of products for residential, commercial, and industrial facilities.
        </p>
        <div class="hero-actions">
          <a href="/en/products" class="btn btn-primary">View Products</a>
          <a href="/en/contact" class="btn btn-secondary">Contact Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Featured Products</h2>
      <p class="section-description">
        Check out our most popular and highest quality products
      </p>
      <ProductGrid products={featuredProducts} locale={locale} showEmpty={false} />
      
      {featuredProducts.length > 0 && (
        <div style="text-align: center; margin-top: 2rem;">
          <a href="/en/products" class="btn btn-primary">All Products</a>
        </div>
      )}
    </div>
  </section>

  <!-- Features Section -->
  <section class="section features-section">
    <div class="container">
      <h2 class="section-title">Why Choose Petel?</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="feature-title">Competitive Prices</h3>
          <p class="feature-description">
            We offer the best price-quality ratio on the market
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3 class="feature-title">Premium Quality</h3>
          <p class="feature-description">
            All products are certified and of proven quality
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <h3 class="feature-title">Fast Delivery</h3>
          <p class="feature-description">
            Efficient delivery throughout Serbia in the shortest time
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="feature-title">Expert Support</h3>
          <p class="feature-description">
            Team of experts ready to help you choose
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Product Categories</h2>
      <div class="categories-grid">
        <a href="/en/products?category=led-lighting" class="category-card">
          <h3>LED Lighting</h3>
          <p>Energy-efficient lighting for all needs</p>
        </a>
        <a href="/en/products?category=switches-and-sockets" class="category-card">
          <h3>Switches and Sockets</h3>
          <p>Quality switches and sockets for your home</p>
        </a>
        <a href="/en/products?category=cables-and-wires" class="category-card">
          <h3>Cables and Wires</h3>
          <p>Wide range of cables and wires</p>
        </a>
        <a href="/en/products?category=distribution-boards" class="category-card">
          <h3>Distribution Boards</h3>
          <p>Distribution boards and equipment</p>
        </a>
        <a href="/en/products?category=automation" class="category-card">
          <h3>Automation</h3>
          <p>Automation and control equipment</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%);
    color: #ffffff;
    padding: 4rem 0;
    text-align: center;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: 3rem;
    margin-bottom: 1.5rem;
    color: #ffffff;
  }

  .hero-description {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    line-height: 1.6;
    opacity: 0.95;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .features-section {
    background-color: #f9fafb;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    text-align: center;
    padding: 2rem;
    background-color: #ffffff;
    border-radius: 0.5rem;
    border: 1px solid #e5e7eb;
  }

  .feature-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #eff6ff;
    border-radius: 50%;
    color: #0066cc;
  }

  .feature-title {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .feature-description {
    color: #6b7280;
    margin: 0;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .category-card {
    padding: 2rem;
    background-color: #ffffff;
    border: 2px solid #e5e7eb;
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  .category-card:hover {
    border-color: #0066cc;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .category-card h3 {
    color: #0066cc;
    margin-bottom: 0.5rem;
  }

  .category-card p {
    color: #6b7280;
    margin: 0;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 3rem 0;
    }

    .hero-title {
      font-size: 2rem;
    }

    .hero-description {
      font-size: 1.125rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .categories-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
